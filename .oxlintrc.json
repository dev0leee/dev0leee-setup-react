{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "eqeqeq": ["error", "smart"],

    // ── import / export ──────────────────────────────────────────────
    // `import {} from 'x'` 처럼 빈 블럭으로 가져오기 금지
    "import/no-empty-named-blocks": "error",
    // export 한 값이 재할당되면 가져간 쪽은 그 변화를 못 본다. const 만 내보낸다.
    "import/no-mutable-exports": "error",
    // AMD(require/define) 금지. ESM 만 쓴다.
    "import/no-amd": "error",
    // 이 프로젝트는 named export 로 통일한다. default export 를 강요하지 않는다.
    "import/prefer-default-export": "off",
    // 상대경로 import 금지. `@/` 절대경로만 쓴다(e2e 는 alias 가 없어 override 에서 끈다).
    // oxlint 는 patterns 의 글롭 문자열(".*", "./*")을 매칭하지 못한다. 조용히 통과하므로
    // 반드시 regex 형태로 쓴다. 바꾸면 src/ 에 상대경로 파일 하나 넣고 실제로 잡히는지 확인할 것.
    "no-restricted-imports": [
      "error",
      {
        "patterns": [{ "regex": "^\\.", "message": "상대경로 대신 '@/' 절대경로를 쓴다." }]
      }
    ],
    // import 정렬(그룹 순서 + 멤버 정렬)은 전부 prettier 가 소유한다.
    // oxlint `sort-imports` 를 같이 켜면 안 된다: prettier 는 `type` 지정자를 뒤로 모으고
    // (`{ clsx, type ClassValue }`) sort-imports 는 순수 알파벳순을 요구해서
    // format 과 lint 가 서로를 무한히 되돌린다. 자동 수정이 되는 prettier 쪽을 남긴다.

    // jsx: "react-jsx"(automatic runtime)라 React를 import하지 않는다.
    "react/react-in-jsx-scope": "off",
    // `import './index.css'` 같은 사이드이펙트 import가 정상 패턴이다.
    "import/no-unassigned-import": "off",
    // axios.create / axios.isAxiosError 는 공식 사용법이다.
    "import/no-named-as-default-member": "off",
    // _retried 는 axios config에 심는 내부 플래그다.
    "no-underscore-dangle": ["warn", { "allow": ["_retried"] }]
  },
  "overrides": [
    {
      // shadcn이 생성/갱신하는 파일. 직접 수정하지 않으므로 규칙을 끈다.
      // 여기 경고를 고치면 다음 `shadcn add` 때 되돌아온다.
      "files": ["src/components/ui/**"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "react/only-export-components": "off",
        "react/jsx-no-constructed-context-values": "off",
        "react/no-array-index-key": "off",
        "no-shadow": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "src/test/**", "src/mocks/**", "e2e/**"],
      "rules": {
        "no-console": "off",
        "typescript/no-explicit-any": "off",
        "react/only-export-components": "off"
      }
    },
    {
      // e2e 는 별도 tsconfig 라 `@/` alias 가 없다. 상대경로가 유일한 선택지다.
      "files": ["e2e/**", "playwright.config.ts"],
      "rules": { "no-restricted-imports": "off" }
    },
    {
      "files": ["src/config/env.ts"],
      "rules": { "no-console": "off" }
    }
  ],
  "ignorePatterns": ["dist", "coverage", "node_modules", "playwright-report", "public"]
}
