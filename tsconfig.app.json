{
  "compilerOptions": {
    /* tsc -b는 composite 프로젝트만 tsbuildinfo로 최신 여부를 판단한다.
       없으면 noEmit 탓에 "출력물이 없다"로 매번 풀 타입체크가 돈다.
       noEmit이 있으므로 .d.ts는 실제로 생성되지 않는다. */
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path alias - vite.config.ts의 resolve.alias와 반드시 같이 유지할 것.
       baseUrl 없이 paths만 쓴다(tsconfig 기준 상대경로). TypeScript 7이 baseUrl을
       제거하므로, 나중에 7로 올릴 때 이 설정을 그대로 쓸 수 있다. */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src"]
}
