# 이 프로젝트가 사용하는 환경변수 목록. src/config/env.ts 의 Zod 스키마가 진짜 계약이다.
#
# 파일 규칙 (Vite)
#   .env                     항상 로드
#   .env.development         `pnpm dev` 에서 로드
#   .env.production          `pnpm build` 에서 로드
#   .env.[mode].local        개인 오버라이드, gitignore 대상
#
# 우선순위: .env.[mode].local > .env.[mode] > .env.local > .env

# API 서버 주소 (필수, URL 형식)
VITE_API_URL=http://localhost:8080/api

# 실행 환경 (필수): development | staging | production
VITE_ENV=development

# MSW 목 서버 사용 여부 (선택, 기본 false)
VITE_ENABLE_MSW=true

# Sentry DSN (선택). 비워두면 Sentry를 초기화하지 않는다.
VITE_SENTRY_DSN=
